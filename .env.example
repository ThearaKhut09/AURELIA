# ─────────────────────────────────────────────────────────────
# AURELIA aurelia — environment configuration
# Copy to .env.local (dev) or set in your host (Vercel) for prod.
# NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL — Neon / Supabase / local docker) ──
DATABASE_URL="postgresql://aurelia:aurelia@localhost:5432/aurelia?schema=public"

# ── Auth (NextAuth) ──
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Site ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Currency & tax ──
# Display-only KHR conversion rate (1 USD ≈ 4,100 KHR). Admin-updatable via env.
NEXT_PUBLIC_KHR_RATE="4100"
# VAT fraction added at checkout. Set "0" if not VAT-registered. Shown as "VAT (10%)".
VAT_RATE="0.1"

# ── ABA PayWay (https://developer.payway.com.kh/) ──
# Sandbox: https://checkout-sandbox.payway.com.kh
# Production: https://checkout.payway.com.kh
PAYWAY_BASE_URL="https://checkout-sandbox.payway.com.kh"
PAYWAY_MERCHANT_ID=""
PAYWAY_API_KEY=""
# Webhook endpoint that receives the JSON pushback from PayWay (this is the
# API-level `return_url`; must be whitelisted in your PayWay merchant portal).
PAYWAY_RETURN_URL="http://localhost:3000/api/payway/webhook"
# Browser redirect after successful payment (API-level `continue_success_url`;
# domain must be whitelisted in your PayWay merchant portal).
PAYWAY_SUCCESS_URL="http://localhost:3000/checkout/success"
# Browser redirect when the customer cancels the PayWay dialog.
PAYWAY_CANCEL_URL="http://localhost:3000/checkout?canceled=1"

# Local development only: lets checkout complete with a simulated payment
# when no PayWay merchant credentials are configured. Automatically disabled
# when NODE_ENV=production.
PAYWAY_DEMO_MODE="true"

# ── Email (Resend) — order confirmations ──
# Leave empty to disable (orders still work; emails are skipped).
RESEND_API_KEY=""
EMAIL_FROM="AURELIA <orders@yourdomain.com>"

# ── Seed admin (only used by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@aurelia.test"
SEED_ADMIN_PASSWORD="Aurelia#2026"
